# MCP PaaS Implementation Configuration
# This file contains example environment variables for configuring the MCP PaaS service
# Copy this file to .env and adjust the values according to your needs

# Environment (development, testing, production)
MCP_ENV=development

# -------------------------
# Server Configuration
# -------------------------
# Host address to bind the server to (default: 0.0.0.0)
MCP_HOST=0.0.0.0
# Port to bind the server to (default: 8000)
MCP_PORT=8000
# Enable debug mode (default: false)
MCP_DEBUG=false
# Number of worker processes (default: 4)
MCP_WORKERS=4
# API route prefix (default: /api/v1)
MCP_API_PREFIX=/api/v1
# Project name
MCP_PROJECT_NAME=MCP PaaS Implementation

# -------------------------
# CORS Configuration
# -------------------------
# List of allowed origins, comma-separated (default: *)
MCP_CORS_ALLOW_ORIGINS=*
# List of allowed HTTP methods, comma-separated (default: *)
MCP_CORS_ALLOW_METHODS=*
# List of allowed HTTP headers, comma-separated (default: *)
MCP_CORS_ALLOW_HEADERS=*
# Allow credentials (default: true)
MCP_CORS_ALLOW_CREDENTIALS=true

# -------------------------
# Authentication and Security
# -------------------------
# REQUIRED: Secret key for JWT token encoding (generate a secure random string)
MCP_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
# JWT encoding algorithm (default: HS256)
MCP_JWT_ALGORITHM=HS256
# Access token expiration in minutes (default: 30)
MCP_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration in days (default: 7)
MCP_REFRESH_TOKEN_EXPIRE_DAYS=7
# Allow anonymous access to certain endpoints (default: false)
MCP_ALLOW_ANONYMOUS=false
# URL for token endpoint (default: /api/v1/auth/token)
MCP_TOKEN_URL=/api/v1/auth/token

# -------------------------
# Resource Limits
# -------------------------
# Maximum number of active contexts per tenant (default: 10)
MCP_MAX_CONTEXTS_PER_TENANT=10
# Maximum memory allocation per tenant in MB (default: 1024)
MCP_MAX_MEMORY_PER_TENANT=1024
# Maximum CPU allocation per tenant in cores (default: 2.0)
MCP_MAX_CPU_PER_TENANT=2.0
# Maximum GPU allocation per tenant in units (default: 0.0)
MCP_MAX_GPU_PER_TENANT=0.0
# Maximum tokens processed per minute per tenant (default: 10000)
MCP_MAX_TOKENS_PER_MINUTE=10000
# Maximum lifetime of a context in hours (default: 24)
MCP_MAX_CONTEXT_LIFETIME=24

# -------------------------
# Logging Configuration
# -------------------------
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL) (default: INFO)
MCP_LOG_LEVEL=INFO
# Log message format (default: %(asctime)s - %(name)s - %(levelname)s - %(message)s)
MCP_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Optional: Log file path (default: None, logs to console only)
# MCP_LOG_FILE=/path/to/log/file.log
# Log rotation interval (default: 1 day)
MCP_LOG_ROTATION=1 day
# Log retention period (default: 30 days)
MCP_LOG_RETENTION=30 days

# -------------------------
# Rate Limiting Configuration
# -------------------------
# Enable rate limiting (default: true)
MCP_RATE_LIMIT_ENABLED=true
# Default requests per minute limit (default: 100)
MCP_RATE_LIMIT_DEFAULT=100
# Rate limit window size in seconds (default: 60)
MCP_RATE_LIMIT_WINDOW=60
# Apply rate limiting by IP address (default: true)
MCP_RATE_LIMIT_BY_IP=true
# Apply rate limiting by tenant (default: true)
MCP_RATE_LIMIT_BY_TENANT=true
# Custom rate limits per tenant, format: tenant_id:limit,tenant_id:limit
# Example: tenant1:200,tenant2:500
MCP_RATE_LIMIT_TENANT_LIMITS=

